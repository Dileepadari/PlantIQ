# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
venv/
.venv/
env/

# Logs
logs
*.log
log.out*

# Editor and OS cruft
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Merge and patch leftovers
*.orig
*.rej
*.bak

# Any dotfile ending in .env, whatever it is called. Match the shape, not the
# name, because the name is the part that gets typed wrong.
*.env
!.env.example

# Local instance state.
#
# Database.db used to be committed, with a comment here explaining that it
# carried the plant profiles and had to stay. It also carried the users table:
# six real names, email addresses and clear-text passwords, published for two
# years. The profiles now live in src/plantiq/data/plants.json, and no database
# file belongs in this repository.
instance/
*.db
*.sqlite
*.sqlite3

# Firmware credentials, copy from Arduino/secrets.example.h
Arduino/secrets.h
secrets.h
