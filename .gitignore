# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
venv/
.venv/
env/

# Logs
logs
*.log
log.out*

# Editor and OS cruft
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Merge and patch leftovers
*.orig
*.rej
*.bak

# Any dotfile ending in .env, whatever it is called. Match the shape, not the
# name, because the name is the part that gets typed wrong.
*.env
!.env.example

# Local instance state. Database.db is committed on purpose: it carries the
# plant threshold profiles the app is useless without.
instance/

# Firmware credentials, copy from Arduino/secrets.example.h
Arduino/secrets.h
secrets.h
