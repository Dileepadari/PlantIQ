# Copy to .env and fill in. Every value has a working default except the
# secret key, which must be set to something private before deploying.

# Signs the session cookie. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
PLANTIQ_SECRET_KEY=change-me

# Shared secret the ESP32 presents when POSTing an alert.
PLANTIQ_DEVICE_TOKEN=
# Required. Alert ingest rejects every request while this is unset.

# ThingSpeak channel the firmware publishes to.
PLANTIQ_TS_CHANNEL=2281910
PLANTIQ_TS_READ_KEY=
# Required for live telemetry. Regenerate it in the ThingSpeak channel settings.
PLANTIQ_TS_TIMEZONE=Asia/Kolkata
PLANTIQ_TS_TIMEOUT=6
PLANTIQ_TS_CACHE_TTL=20

# Feed host. Override to point at a stand-in that serves the same JSON, which
# is how the README screenshots are taken without live hardware.
PLANTIQ_TS_BASE_URL=https://api.thingspeak.com

# Absolute path to the SQLite file. Defaults to src/Database.db, which is
# created on first start. No database file belongs in this repository.
PLANTIQ_DATABASE=

# Local dev server.
PLANTIQ_HOST=127.0.0.1
PLANTIQ_PORT=5000
PLANTIQ_DEBUG=1
